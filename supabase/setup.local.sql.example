-- ============================================================================
--  STEP 1 — Create the couple and both invites.  Run once.
--  Returns two tokens. Copy them into the block above immediately.
-- ============================================================================

with new_couple as (
  insert into public.couples (name, started_at)
  values ('Us', null)                    -- start date left null on purpose;
  returning id                           -- set it for real in STEP 2
)
insert into public.invites (token, couple_id, email, display_name, expires_at)
select
  encode(gen_random_bytes(16), 'hex'),
  new_couple.id,
  v.email,
  v.display_name,
  now() + interval '365 days'
from new_couple,
  (values
    ('you@example.com',  'Your name'),
    ('her@example.com',               'Her name')   -- <-- her real email
  ) as v(email, display_name)
returning token, email, display_name;


