# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and will never be committed.

# --- Supabase ---
# Project Settings -> Data API  (and API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix with NEXT_PUBLIC_ and never expose to the browser.
# Used only by trusted server routes (e.g. redeeming an invite token).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (date generator) ---
ANTHROPIC_API_KEY=your-anthropic-key

# --- App ---
# Used to build magic-link / invite redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
